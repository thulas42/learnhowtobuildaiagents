# App
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="https://learnhowtobuildaiagents.com"
NEXTAUTH_SECRET="your-secret-key-here"

# Search engine verification (optional)
GOOGLE_SITE_VERIFICATION=""
BING_SITE_VERIFICATION=""
YANDEX_VERIFICATION=""

# OAuth (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Payments — Paystack (optional; EFT works without)
PAYSTACK_SECRET_KEY=""
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=""
NEXT_PUBLIC_PAYSTACK_ENABLED="false"
PAYSTACK_PLAN_STANDARD=""
PAYSTACK_PLAN_PREMIUM=""

# Email — Resend (optional)
RESEND_API_KEY=""

# Admin
ADMIN_SECRET=""
ADMIN_EMAIL="you@example.com"

# Observability
NEXT_PUBLIC_SENTRY_DSN=""
NEXT_PUBLIC_UMAMI_WEBSITE_ID=""
NEXT_PUBLIC_UMAMI_SCRIPT_URL=""

# Database (future — Prisma; runtime uses data/*.json today)
DATABASE_URL="postgresql://user:password@localhost:5432/ai_course_db"

# Legacy SMTP (optional)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="noreply@aiagentcourse.com"

# Storage (optional, for certificate PDFs)
AWS_S3_BUCKET=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
