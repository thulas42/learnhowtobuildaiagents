generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Authentication & Users ─────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String?
  image         String?
  locale        String    @default("en")
  timezone      String    @default("UTC")
  learningPath  LearningPath @default(STANDARD)
  role          Role      @default(STUDENT)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  progress      UserProgress[]
  quizAttempts  QuizAttempt[]
  certificates  Certificate[]
  projects      ProjectSubmission[]
  examAttempts  ExamAttempt[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// ─── Course Content ─────────────────────────────────────────────────────────

model Module {
  id          String   @id @default(cuid())
  number      Int      @unique
  titleKey    String   // i18n key for title
  descKey     String   // i18n key for description
  duration    String   // e.g., "Week 1", "Weeks 2-3"
  order       Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lessons     Lesson[]
  objectives  ModuleObjective[]

  @@map("modules")
}

model ModuleObjective {
  id        String @id @default(cuid())
  moduleId  String
  textKey   String // i18n key
  order     Int

  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@map("module_objectives")
}

model Lesson {
  id          String   @id @default(cuid())
  moduleId    String
  number      String   // e.g., "1.1", "2.3"
  titleKey    String   // i18n key
  contentKey  String   // i18n key for lesson content
  order       Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  module      Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  quiz        Quiz?
  codeExercises CodeExercise[]

  @@map("lessons")
}

model CodeExercise {
  id            String @id @default(cuid())
  lessonId      String
  titleKey      String
  descriptionKey String
  starterCode   String
  solutionCode  String
  testCode      String
  order         Int

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@map("code_exercises")
}

// ─── Quiz System ────────────────────────────────────────────────────────────

model Quiz {
  id            String   @id @default(cuid())
  lessonId      String   @unique
  passingScore  Float    @default(0.6) // 60% default
  maxAttempts   Int      @default(-1)  // -1 = unlimited
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  lesson    Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  questions QuizQuestion[]
  attempts  QuizAttempt[]

  @@map("quizzes")
}

model QuizQuestion {
  id              String       @id @default(cuid())
  quizId          String
  type            QuestionType
  questionKey     String       // i18n key for question text
  explanationKey  String       // i18n key for explanation
  options         Json?        // JSON array of option objects
  correctAnswer   Json         // correct answer(s)
  codeSnippet     String?      // optional code block
  difficulty      Int          @default(1) // 1-5
  order           Int

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@map("quiz_questions")
}

model QuizAttempt {
  id          String   @id @default(cuid())
  userId      String
  quizId      String
  score       Float
  answers     Json     // user's answers
  passed      Boolean
  startedAt   DateTime @default(now())
  completedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@map("quiz_attempts")
}

// ─── Progress Tracking ──────────────────────────────────────────────────────

model UserProgress {
  id          String         @id @default(cuid())
  userId      String
  lessonId    String
  status      ProgressStatus @default(NOT_STARTED)
  completedAt DateTime?
  updatedAt   DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@map("user_progress")
}

// ─── Final Exam ─────────────────────────────────────────────────────────────

model ExamAttempt {
  id          String   @id @default(cuid())
  userId      String
  score       Float
  answers     Json
  passed      Boolean
  startedAt   DateTime @default(now())
  completedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("exam_attempts")
}

// ─── Projects ───────────────────────────────────────────────────────────────

model ProjectSubmission {
  id            String        @id @default(cuid())
  userId        String
  projectType   ProjectType
  title         String
  description   String
  repoUrl       String?
  demoUrl       String?
  reportUrl     String?
  score         Float?
  feedback      String?
  status        ProjectStatus @default(SUBMITTED)
  submittedAt   DateTime      @default(now())
  reviewedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("project_submissions")
}

// ─── Certificates ───────────────────────────────────────────────────────────

model Certificate {
  id              String           @id @default(cuid())
  userId          String
  certificateId   String           @unique // e.g., CERT-2026-AI-AGT-xxxxx
  level           CertificateLevel
  pdfUrl          String?
  pngUrl          String?
  verificationUrl String
  issuedAt        DateTime         @default(now())
  revokedAt       DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("certificates")
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum Role {
  STUDENT
  INSTRUCTOR
  ADMIN
}

enum LearningPath {
  FAST_TRACK
  STANDARD
  EXTENDED
}

enum QuestionType {
  MULTIPLE_CHOICE
  MULTIPLE_SELECT
  MATCHING
  SHORT_ANSWER
  CODE_COMPREHENSION
  CODE_COMPLETION
  SCENARIO
  DESIGN
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum ProjectType {
  CUSTOMER_SUPPORT
  RESEARCH_ASSISTANT
  MULTI_AGENT
  CAPSTONE
}

enum ProjectStatus {
  SUBMITTED
  IN_REVIEW
  APPROVED
  NEEDS_REVISION
}

enum CertificateLevel {
  COMPLETION
  DISTINCTION
  EXCELLENCE
}
